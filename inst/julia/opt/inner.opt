# KNITRO 15.1 options for the inner loop
# (convex dual over (eta, zeta, lambda))
nlp_algorithm 0
convex        1
gradopt       1
hessopt       2
feastol       1e-08
feastol_abs   1e-06
opttol        1e-08
opttol_abs    1e-06
ftol          1e-15
ftol_iters    5
xtol          1e-12
outlev        0
outmode       0
honorbnds     1
maxit         3000
